{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch ArtSpark.Web (HTTP)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/ArtSpark.Web/bin/Debug/net10.0/ArtSpark.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ArtSpark.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5139"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(http://localhost:[0-9]+)",
        "uriFormat": "%s"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/ArtSpark.Web/Views"
      }
    },
    {
      "name": "Launch ArtSpark.Web (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/ArtSpark.Web/bin/Debug/net10.0/ArtSpark.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ArtSpark.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7282;http://localhost:5139"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://localhost:[0-9]+)",
        "uriFormat": "%s"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/ArtSpark.Web/Views"
      }
    },
    {
      "name": "Attach to ArtSpark.Web",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Launch ArtSpark.Console",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-console",
      "program": "${workspaceFolder}/ArtSpark.Console/bin/Debug/net10.0/ArtSpark.Console.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ArtSpark.Console",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
